---
/**
 * Planet Rose: VIP Room booking, organised by NIGHT.
 * Availability and bookings come from the reservation engine (Apps Script +
 * Google Calendar, see /reservas-engine). Card details go straight to Stripe.
 *
 * Two screens inside one card: "pick" (duration, month calendar, times) and
 * "details" (guest info + card). Then "done".
 */
import { getContent } from '../../lib/content.js';

const c = await getContent();
const st = c.settings;
const tel = `tel:${st.phone}`;
const canonical = new URL('/reserve/vip/', Astro.site).href;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Reserve the VIP Room · Planet Rose Karaoke Bar</title>
  <meta name="description" content="Book the private VIP karaoke room at Planet Rose, inside Tropicana Atlantic City. Pick your night, your time and how many hours.">
  <meta name="theme-color" content="#141414">
  <link rel="canonical" href={canonical}>
  <link rel="icon" href="/assets/brand/logo-transparent.png">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Archivo:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/css/reset.css">
  <link rel="stylesheet" href="/css/layout.css">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/booking.css">

  <script is:inline src="/js/booking.js" defer></script>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>

  <header class="bk-top">
    <div class="container bk-top__inner">
      <a class="nav__brand" href="/" aria-label="Planet Rose Karaoke Bar, home">
        <img src="/assets/brand/logo-transparent.png" alt="" width="48" height="48">
        <span class="nav__wordmark">Planet Rose<small>Karaoke Bar · AC</small></span>
      </a>
      <a class="btn btn--ghost bk-top__call" href={tel}>Call {st.phoneDisplay}</a>
    </div>
  </header>

  <main id="main" class="container bk-wrap" data-booking data-resource="vip" data-phone={st.phoneDisplay}>
    <p class="bk-banner" data-test-banner hidden>Test mode: bookings are marked [TEST] and no real card is charged.</p>

    <div class="bk-card">
      <!-- ============ Left: what you're booking ============ -->
      <aside class="bk-info">
        <button class="bk-back" type="button" data-back hidden aria-label="Back to date and time">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
        </button>
        <p class="bk-info__brand">Planet Rose</p>
        <h1 class="bk-info__title">VIP Room Reservation</h1>
        <ul class="bk-meta" role="list">
          <li>
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
            <span data-meta-duration>1 hour</span>
          </li>
          <li>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z" /><circle cx="12" cy="9.5" r="2.5" /></svg>
            <span>Inside Tropicana · 2801 Pacific Ave, Atlantic City</span>
          </li>
          <li class="bk-meta__when" data-meta-when hidden>
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15" rx="1.5" /><path d="M3.5 10h17M8 3v4M16 3v4" /></svg>
            <span data-meta-when-text></span>
          </li>
          <li>
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3c3 3.3 3 14.7 0 18M12 3c-3 3.3-3 14.7 0 18" /></svg>
            <span>Eastern Time (Atlantic City)</span>
          </li>
        </ul>
        <details class="bk-about" data-about open>
          <summary>The VIP Room</summary>
          <p class="bk-about__pitch">Your own soundproof glass room in the middle of the bar. Everyone can see the party; only your group hears the music.</p>
          <ul class="bk-feats" role="list">
            <li>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a3 3 0 0 1 3 3v5a3 3 0 0 1-6 0V6a3 3 0 0 1 3-3z" /><path d="M6 11a6 6 0 0 0 12 0M12 17v4" /></svg>
              <span><strong>Be your own DJ</strong> with our pro karaoke system, Wi-Fi mics and lyric monitors</span>
            </li>
            <li>
              <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3" /><path d="M3.5 19a5.5 5.5 0 0 1 11 0M16 5.5a3 3 0 0 1 0 5.5M17.5 14a5 5 0 0 1 3 5" /></svg>
              <span><strong>Up to 20 guests</strong> with wrap-around seating and room to dance</span>
            </li>
            <li>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3h8l-1 7a3 3 0 0 1-6 0L8 3zM12 13v8M8.5 21h7" /></svg>
              <span><strong>Dedicated server</strong> for food and drinks all session</span>
            </li>
            <li>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v18M4.2 7.5l15.6 9M4.2 16.5l15.6-9" /></svg>
              <span><strong>Private and air-conditioned</strong>: the main bar can't hear you</span>
            </li>
          </ul>
        </details>

        <div class="bk-price">
          <p class="bk-price__title">Pricing</p>
          <dl>
            <div><dt>Room</dt><dd>$10 per person / hour</dd></div>
            <div><dt>5 guests or fewer</dt><dd>$50 / hour minimum</dd></div>
            <div><dt>Gratuity</dt><dd>20% added to the bill</dd></div>
          </dl>
          <p class="bk-price__note" data-about-price>Paid at the bar on the night. Food and drinks are separate.</p>
        </div>
      </aside>

      <!-- ============ Right: steps ============ -->
      <div class="bk-main">
        <div class="bk__status" data-status role="status" aria-live="polite">
          <span class="bk-spinner" aria-hidden="true"></span> Loading available nights…
        </div>

        <!-- Screen 1: duration + calendar + times -->
        <section class="bk-screen" data-screen="pick" hidden aria-labelledby="pick-title">
          <h2 class="bk-main__title" id="pick-title">Select a night &amp; time</h2>

          <div class="bk-duration" role="radiogroup" aria-label="How long would you like the room?">
            <span class="bk-duration__label">How long?</span>
            <button type="button" role="radio" data-duration="1">1 hour</button>
            <button type="button" role="radio" data-duration="2">2 hours</button>
            <button type="button" role="radio" data-duration="3">3 hours</button>
          </div>

          <div class="bk-pick">
            <div class="bk-cal">
              <div class="bk-cal__head">
                <button class="bk-cal__nav" type="button" data-month="-1" aria-label="Previous month">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
                </button>
                <p class="bk-cal__month" data-month-label aria-live="polite"></p>
                <button class="bk-cal__nav" type="button" data-month="1" aria-label="Next month">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
                </button>
              </div>
              <div class="bk-cal__grid" role="grid" data-grid>
                <span class="bk-cal__wd">Sun</span><span class="bk-cal__wd">Mon</span><span class="bk-cal__wd">Tue</span><span class="bk-cal__wd">Wed</span><span class="bk-cal__wd">Thu</span><span class="bk-cal__wd">Fri</span><span class="bk-cal__wd">Sat</span>
              </div>
              <p class="bk-cal__hint">Each date is <strong>that night</strong>, from 9 PM. Times after midnight stay on the night you pick.</p>
              <ul class="bk-know" role="list" aria-label="Good to know">
                <li data-card-only>💳 Card required</li>
                <li>⏱ 30-min grace period</li>
                <li>⚠️ Cancel 3+ hrs ahead<span data-card-only> or <span data-fee>$50</span> fee</span></li>
                <li>🪪 21+ with ID</li>
              </ul>

              <aside class="bk-alt">
                <p class="bk-alt__title">Can't find the time you want?</p>
                <p>Get a table in our main room: <strong>$20 per person for the whole night</strong>, no cover, full karaoke and bar service. 20% gratuity included on the check.</p>
                <a class="btn btn--ghost bk-alt__btn" href="/?type=table#plan">Request a table</a>
              </aside>
            </div>

            <div class="bk-times" data-times-panel hidden>
              <p class="bk-times__night" data-times-night></p>
              <div class="bk-times__list" data-times></div>
            </div>
          </div>
        </section>

        <!-- Screen 2: details + card -->
        <form class="bk-screen" data-screen="details" hidden novalidate aria-labelledby="details-title">
          <h2 class="bk-main__title" id="details-title">Enter details</h2>

          <div class="bk-fields">
            <div class="field">
              <label for="b-first">First name <span class="req" aria-hidden="true">*</span></label>
              <input id="b-first" name="first" type="text" autocomplete="given-name" maxlength="40" required>
              <p class="field__error" id="b-first-err"></p>
            </div>
            <div class="field">
              <label for="b-last">Last name <span class="req" aria-hidden="true">*</span></label>
              <input id="b-last" name="last" type="text" autocomplete="family-name" maxlength="40" required>
              <p class="field__error" id="b-last-err"></p>
            </div>
            <div class="field field--full">
              <label for="b-email">Email <span class="req" aria-hidden="true">*</span></label>
              <input id="b-email" name="email" type="email" autocomplete="email" maxlength="120" required>
              <p class="field__error" id="b-email-err"></p>
            </div>
            <div class="field">
              <label for="b-phone">Phone number <span class="req" aria-hidden="true">*</span></label>
              <div class="bk-phone">
                <span aria-hidden="true">+1</span>
                <input id="b-phone" name="phone" type="tel" autocomplete="tel-national" inputmode="tel" maxlength="20" required>
              </div>
              <p class="field__error" id="b-phone-err"></p>
            </div>
            <div class="field">
              <label for="b-guests">Amount of guests <span class="req" aria-hidden="true">*</span></label>
              <input id="b-guests" name="guests" type="number" min="1" max="500" inputmode="numeric" required>
              <p class="field__error" id="b-guests-err"></p>
            </div>
            <div class="field field--full">
              <label for="b-notes">Special requests or notes</label>
              <textarea id="b-notes" name="notes" rows="2" maxlength="300" placeholder="Birthday, bachelorette, anything we should know"></textarea>
            </div>
            <div class="bk-hp" aria-hidden="true">
              <label for="b-website">Website</label>
              <input id="b-website" name="website" type="text" tabindex="-1" autocomplete="off">
            </div>
          </div>

          <div class="bk-cardbox" data-card-box>
            <p class="bk-cardbox__title">Card to hold your reservation <span class="req" aria-hidden="true">*</span></p>
            <p class="bk-cardbox__note"><strong>Nothing is charged today.</strong> We only charge a <span data-fee>$50</span> fee if you don't show up or cancel less than <span data-notice>3</span> hours before.</p>
            <div class="bk-cardbox__element" data-card-element></div>
            <p class="field__error" data-card-error></p>
            <p class="bk-cardbox__secure">
              <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="10.5" width="14" height="10" rx="1.5" /><path d="M8 10.5V7.5a4 4 0 0 1 8 0v3" /></svg>
              Secured by Stripe. Planet Rose never sees or stores your card number.
            </p>
          </div>

          <div class="bk-group" data-group-note hidden>
            <p class="bk-group__title">Planning for more than <span data-max-guests>20</span> guests?</p>
            <p>Groups this size need a custom plan, so we don't book them online. Send your request and <strong>one of our agents will contact you</strong> to set it up. Nothing is reserved yet.</p>
          </div>

          <section class="bk-rules" data-solo aria-labelledby="rules-title">
            <h3 class="bk-rules__title" id="rules-title">Before you confirm</h3>
            <ol class="bk-rules__list">
              <li><strong>Be on time.</strong> We hold the room for <span data-grace>30</span> minutes. After that the reservation is cancelled<span data-card-only> and the no-show fee applies</span>.</li>
              <li><strong>Cancel at least <span data-notice>3</span> hours before.</strong> Call <span data-phone-text></span> to cancel or change<span data-nocard-only>, so we can offer the room to another group</span>.<span data-card-only> No-shows and later cancellations are charged <span data-fee>$50</span> to the card on file.</span></li>
              <li><strong>Your time ends on time.</strong> The room is yours for the hours you book. Want to stay longer? Ask your server; we'll extend it if the next slot is free.</li>
              <li><strong>Up to <span data-max-guests>20</span> guests, all 21+</strong> with a valid ID at the door.</li>
              <li><strong>Room fee is paid at the bar</strong> on the night: $10 per person per hour ($50 minimum per hour) plus 20% gratuity added to the bill.<span data-card-only> Nothing is charged today.</span></li>
              <li><strong>After midnight = same night.</strong> A Friday 12:00 AM booking is Friday night, in the early hours of Saturday.</li>
            </ol>
          </section>

          <label class="bk-check" data-solo>
            <input type="checkbox" name="policy" required>
            <span>I have read and agree to the reservation rules above<span data-card-only>, including the <span data-fee>$50</span> no-show / late cancellation fee</span>.</span>
          </label>
          <p class="field__error" id="b-policy-err"></p>

          <div data-turnstile class="bk-turnstile"></div>
          <button class="btn btn--red btn--lg bk-submit" type="submit" data-submit>Confirm reservation</button>
          <p class="field__error bk-form-error" data-form-error role="alert"></p>
        </form>

        <!-- Screen 3: done -->
        <section class="bk-screen bk-done" data-screen="done" hidden tabindex="-1" aria-labelledby="done-title">
          <div class="bk-done__icon" aria-hidden="true">✓</div>
          <h2 class="bk-main__title" id="done-title">You're booked!</h2>
          <dl class="bk-done__list" data-done-list></dl>
          <p class="bk-done__text">We sent the details to <strong data-done-email></strong>. Need to change or cancel? Call us at <a href={tel}>{st.phoneDisplay}</a> at least 3 hours before your start time.</p>
          <a class="btn btn--red btn--lg" href="/">Back to Planet Rose</a>
        </section>

        <!-- Screen 4: large-group request sent -->
        <section class="bk-screen bk-done" data-screen="sent" hidden tabindex="-1" aria-labelledby="sent-title">
          <div class="bk-done__icon" aria-hidden="true">✓</div>
          <h2 class="bk-main__title" id="sent-title">Request received!</h2>
          <p class="bk-done__text">Thanks, <strong data-sent-name></strong>. One of our agents will contact you at <strong data-sent-email></strong> or by phone to plan your group. Questions now? Call <a href={tel}>{st.phoneDisplay}</a>.</p>
          <a class="btn btn--red btn--lg" href="/">Back to Planet Rose</a>
        </section>
      </div>
    </div>
  </main>

  <footer class="bk-foot container">
    <p>Planet Rose Karaoke Bar · {st.addressVenue}, {st.addressStreet}, {st.addressCity}, {st.addressRegion} {st.addressZip} · 21+ with valid ID · <a href={tel}>{st.phoneDisplay}</a></p>
  </footer>
</body>
</html>
